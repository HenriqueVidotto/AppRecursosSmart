{
  "expo": {
    "name": "AppRecursosSmart",
    "slug": "AppRecursosSmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [ 
      [ 
        "expo-camera", 
        { 
          "cameraPermission": "Permitir que o AppRecursosSmart utilize a câmera para tirar fotografias.", 
          "microphonePermission": "Permitir que o AppRecursosSmart utilize o microfone.", 
          "recordAudioAndroid": true 
        } 
      ],
       [ 
        "expo-location", 
        { 
          "locationWhenInUsePermission": "Permitir que o AppRecursosSmart acesse sua localização enquanto estiver utilizando o aplicativo." 
        } 
      ] 
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
    
  }
}
